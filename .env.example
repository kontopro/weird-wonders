# Copy to .env.local and replace these values with the current blog's project values.
# Never expose a secret/service-role key through a VITE_ variable.
VITE_DATA_SOURCE=mock
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Mock mode only: open the admin on a deployed demo (it is always open in `bun run dev`).
VITE_ENABLE_DEMO_ADMIN=false
# Server-only (Supabase mode): lets owners/admins send team invitations.
# Never prefix with VITE_ and never commit a real value.
SUPABASE_SECRET_KEY=
# Public address of this deployment, used in canonical/hreflang links, the
# sitemap, RSS feeds and social previews. Defaults to https://<siteConfig.domain>.
VITE_SITE_URL=https://factaki.gr
# Server-only: e-mails (newsletter confirmation) through Resend. Verify the
# sender's domain in Resend first. Without these, no e-mails are sent (mock
# mode shows them at /admin/subscribers instead). Never prefix with VITE_.
RESEND_API_KEY=
EMAIL_FROM="FACTάκι <newsletter@factaki.gr>"
